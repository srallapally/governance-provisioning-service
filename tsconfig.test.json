{
  // Typecheck the tests too.
  //
  // tsconfig.json excludes **/*.test.ts because they must not be emitted into
  // dist. The side effect was that nothing typechecked them at all: when
  // claimBatch's availability parameter changed shape at P1.5, every test call
  // site kept compiling, passed a number where an object was expected, and the
  // caps arrived as NaN -- which Postgres turned into a NULL comparison and a
  // silently empty claim. A type error would have said so in one line.
  //
  // noEmit, so this is a check and not a second build.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": "."
  },
  "include": ["src/**/*", "test/**/*", "*.ts"],
  "exclude": ["dist", "node_modules"]
}
