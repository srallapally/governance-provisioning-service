{
  "name": "governance-provisioning-service",
  "version": "0.1.0",
  "private": true,
  "description": "Async provisioning service: operation table, dispatcher, admission, and the HTTP surface over the governance connector framework",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "keywords": [
    "governance",
    "provisioning",
    "identity",
    "connector"
  ],
  "devDependencies": {
    "@types/node": "^22.5.0",
    "eslint": "^9.10.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vitest": "^3.2.4"
  }
}
