{
  "name": "governance-provisioning-service",
  "version": "0.1.0",
  "private": true,
  "description": "Async provisioning service: operation table, dispatcher, admission, and the HTTP surface over the governance connector framework",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "eslint .",
    "soak": "tsx test/load/soak.ts",
    "test": "vitest run",
    "test:pg": "vitest run test/contract/operation-store.pg.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "governance",
    "provisioning",
    "identity",
    "connector"
  ],
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.10",
    "eslint": "^9.10.0",
    "tsx": "^4.16.2",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@governance-connector-framework/core": "file:vendor/governance-connector-framework-core-1.6.0-94030e4.tgz",
    "pg": "^8.13.0"
  }
}
